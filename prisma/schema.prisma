generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id             String        @id @default(uuid()) @db.Uuid
  platform       String
  externalBookId String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  detail         BookDetail?
  rankingItems   RankingItem[]
  downloads      BookDownload[]

  @@unique([platform, externalBookId])
}

model BookDetail {
  bookId      String   @id @db.Uuid
  title       String
  author      String
  description String?
  coverUrl    String?
  genres      String[] @default([])
  bookStatus  String?
  wordCount   Int?
  metadata    Json     @default("{}") @db.JsonB
  sourceUrl   String
  fetchedAt   DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model RankingSnapshot {
  id          String        @id @default(uuid()) @db.Uuid
  platform    String
  rankTypeKey String
  rankType    String
  sourceUrl   String
  fetchedAt   DateTime      @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  items       RankingItem[]

  @@index([platform, rankTypeKey, fetchedAt(sort: Desc)])
}

model RankingItem {
  id             String          @id @default(uuid()) @db.Uuid
  snapshotId     String          @db.Uuid
  bookId         String          @db.Uuid
  rank           Int
  externalBookId String
  title          String
  author         String
  coverUrl       String?
  sourceUrl      String
  metrics        Json            @default("{}") @db.JsonB
  snapshot       RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  book           Book            @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, rank])
  @@unique([snapshotId, externalBookId])
  @@index([bookId])
}


enum BookDownloadStatus {
  QUEUED
  RUNNING
  CANCELING
  SUCCEEDED
  FAILED
  CANCELED
}

model BookDownload {
  id                String             @id @default(uuid()) @db.Uuid
  bookId            String             @db.Uuid
  startChapter      Int?
  endChapter        Int?
  status            BookDownloadStatus @default(QUEUED)
  downstreamJobId   String?
  progress          Json               @default("{}") @db.JsonB
  artifactPath      String?
  artifactFilename  String?
  artifactSizeBytes Int?
  artifactSha256    String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  startedAt         DateTime?          @db.Timestamptz(3)
  finishedAt        DateTime?          @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  book              Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([bookId, createdAt(sort: Desc)])
}
