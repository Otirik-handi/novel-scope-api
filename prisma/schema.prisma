generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id             String        @id @default(uuid()) @db.Uuid
  platform       String
  externalBookId String        @map("external_book_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  detail         BookDetail?
  rankingItems   RankingItem[]

  @@unique([platform, externalBookId])
  @@map("books")
}

model BookDetail {
  id            String   @id @default(uuid()) @db.Uuid
  bookId        String   @unique @map("book_id") @db.Uuid
  title         String
  author        String
  genres        Json     @default("[]") @db.JsonB
  description   String?
  bookStatus    String?  @map("book_status")
  wordCount     Int?     @map("word_count")
  totalRecCount Int?     @map("total_rec_count")
  chaptersNum   Int?     @map("chapters_num")
  monthCount    Int?     @map("month_count")
  recCount      Int?     @map("rec_count")
  rewardNum     Int?     @map("reward_num")
  sourceUrl     String   @map("source_url")
  fetchedAt     DateTime @map("fetched_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  status        String
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("book_details")
}

model RankingSnapshot {
  id        String        @id @default(uuid()) @db.Uuid
  platform  String
  rankType  String        @map("rank_type")
  sourceUrl String        @map("source_url")
  fetchedAt DateTime      @map("fetched_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  items     RankingItem[]
  crawlLogs CrawlLog[]

  @@index([platform, rankType, fetchedAt(sort: Desc)])
  @@map("ranking_snapshots")
}

model RankingItem {
  id             String          @id @default(uuid()) @db.Uuid
  snapshotId     String          @map("snapshot_id") @db.Uuid
  bookId         String?         @map("book_id") @db.Uuid
  externalBookId String          @map("external_book_id")
  rank           Int
  title          String
  author         String
  metrics        Json            @default("{}") @db.JsonB
  sourceUrl      String          @map("source_url")
  snapshot       RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  book           Book?           @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, rank])
  @@unique([snapshotId, externalBookId])
  @@index([bookId])
  @@map("ranking_items")
}

model CrawlLog {
  id           String           @id @default(uuid()) @db.Uuid
  targetType   String           @map("target_type")
  targetKey    String           @map("target_key")
  platform     String
  startedAt    DateTime         @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?        @map("finished_at") @db.Timestamptz(6)
  status       String
  errorMessage String?          @map("error_message")
  snapshotId   String?          @map("snapshot_id") @db.Uuid
  snapshot     RankingSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([platform, targetType, targetKey, startedAt(sort: Desc)])
  @@map("crawl_log")
}
