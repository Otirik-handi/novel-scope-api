# ---- 必填 ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novel_scope
QIDIAN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36 Edg/150.0.0.0

# ---- 可选 ----
PORT=3000
QIDIAN_REQUEST_TIMEOUT_MS=30000
FANQIE_REQUEST_TIMEOUT_MS=30000
BOOK_DETAIL_TTL_HOURS=3
RANKING_REFRESH_CRON=0 0 6 * * *
FANQIE_RANKING_REFRESH_CRON=0 30 0 * * *
RANKING_REFRESH_TIME_ZONE=Asia/Shanghai

